# Skopiuj do .env i uzupełnij. .env nie trafia do repozytorium.
#
# Katalogi na hoście przed pierwszym `docker compose up`:
#   sudo mkdir -p /srv/gtfs/pgdata /srv/gtfs/data
#   sudo chown -R 10001:10001 /srv/gtfs/data     # UID z Dockerfile

# --- baza ---
# Hasło występuje dwa razy - podstaw to samo. Rolę zostaw `postgres`: zrzut
# niesie właściciela obiektów, restore na inną rolę wymagałby --no-owner.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ZMIEN_MNIE
POSTGRES_DB=gtfs_olap
GTFS_DB_URL=postgresql://postgres:ZMIEN_MNIE@db:5432/gtfs_olap

# --- katalogi w kontenerze (bind-mount /srv/gtfs/data) ---
GTFS_RAW_DIR=/data/raw
GTFS_EXPORT_DIR=/data/export
GTFS_STATE_DIR=/data/state

# --- kolektor ---
GTFS_RT_INTERVAL_S=20
GTFS_RT_TIMEOUT_S=10
GTFS_ARCHIVE_VP=1
GTFS_VP_TIMEOUT_S=5

# --- Google Drive ---
# Konfigurację utwórz na swoim komputerze (`rclone authorize "drive"`) i skopiuj
# do secrets/rclone.conf. Nie używaj konta serwisowego - nie ma własnego limitu
# przestrzeni. Załóż też własny client_id; wbudowany w rclone wpada w limity API.
GTFS_RCLONE_REMOTE=gdrive:gtfs-olap

# --- retencja lokalna ---
# Musi być większe niż start_offset agregatów w CA.sql (6h).
GTFS_FAKTY_RETENCJA_H=48
GTFS_UPLOAD_QUIET_MIN=10

# --- monitoring ---
# Pusty URL = tylko logi. Wpisz adres healthchecks.io, żeby dostać sygnał,
# gdy kolektor przestanie zbierać.
GTFS_HEALTHCHECK_URL=
GTFS_MIN_FREE_GB=15
GTFS_MAX_ETL_CISZA_MIN=5
GTFS_MAX_STAGING_H=3
GTFS_MAX_NIGHTLY_H=26
