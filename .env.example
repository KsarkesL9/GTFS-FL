# Skopiuj do .env i uzupełnij. Plik .env NIE trafia do repozytorium.
#
# Przygotowanie katalogów na hoście przed pierwszym `docker compose up`:
#   sudo mkdir -p /srv/gtfs/pgdata /srv/gtfs/data
#   sudo chown -R 10001:10001 /srv/gtfs/data     # UID użytkownika z Dockerfile

# --- baza ---
# Hasło występuje dwa razy: raz dla obrazu Postgresa, raz w URL-u dla aplikacji.
# Podstaw to samo w obu miejscach.
#
# Nazwa roli celowo zostaje `postgres`. Zrzut z bazy lokalnej niesie właściciela
# obiektów; restore na inną rolę wymagałby --no-owner i ręcznego prostowania
# uprawnień. Zmieniamy hasło, nie nazwę użytkownika.
#
# Lokalnie (docker-compose.local.yml) użyj poświadczeń SWOJEJ istniejącej bazy,
# czyli najpewniej postgres/postgres - inaczej nie zobaczysz danych historycznych.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ZMIEN_MNIE
POSTGRES_DB=gtfs_olap
GTFS_DB_URL=postgresql://postgres:ZMIEN_MNIE@db:5432/gtfs_olap

# --- katalogi w kontenerze (bind-mount /srv/gtfs/data) ---
GTFS_RAW_DIR=/data/raw
GTFS_EXPORT_DIR=/data/export
GTFS_STATE_DIR=/data/state

# --- kolektor ---
GTFS_RT_INTERVAL_S=20
GTFS_RT_TIMEOUT_S=10
# Archiwum strumienia pozycji pojazdów. Bez parsowania do bazy (decyzja D1),
# ale strumień jest ulotny - wyłączenie zamyka trwale kierunek z rozdz. 6.2.
GTFS_ARCHIVE_VP=1
GTFS_VP_TIMEOUT_S=5

# --- Google Drive ---
# Konfigurację utwórz na SWOIM komputerze (`rclone authorize "drive"`) i skopiuj
# wynik do secrets/rclone.conf. Nie używaj konta serwisowego - nie ma własnego
# limitu przestrzeni na koncie prywatnym. Załóż też własny client_id w Google
# Cloud Console; wbudowany w rclone jest współdzielony i wpada w limity API.
GTFS_RCLONE_REMOTE=gdrive:gtfs-olap

# --- retencja lokalna ---
# Musi być WIĘKSZE niż start_offset agregatów w CA.sql (6h) i pokrywać całą
# eksportowaną dobę D-1 z zapasem na jedną nieudaną noc.
GTFS_FAKTY_RETENCJA_H=48
GTFS_UPLOAD_QUIET_MIN=10

# --- monitoring ---
# Pusty URL = tylko logi. Wpisz adres healthchecks.io / ntfy, żeby dostać
# sygnał, gdy kolektor przestanie zbierać - luk nie da się nadrobić.
GTFS_HEALTHCHECK_URL=
GTFS_MIN_FREE_GB=15
GTFS_MAX_ETL_CISZA_MIN=5
GTFS_MAX_STAGING_H=3
GTFS_MAX_NIGHTLY_H=26
